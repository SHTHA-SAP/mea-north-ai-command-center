{
  "hosting": {
    "public": ".",
    "ignore": [
      "firebase.json",
      ".firebaserc",
      ".gitignore",
      ".git/**",
      "**/node_modules/**",
      "~$*",
      "*.py",
      "*.txt",
      "v118pkg/**",
      "EMEA AI Adoption Report*",
      "*.xlsx",
      "*.xlsb",
      "README.md"
    ],
    "headers": [
      {
        "source": "**/*.xlsx",
        "headers": [
          { "key": "Cache-Control", "value": "public, max-age=0, must-revalidate" },
          { "key": "Access-Control-Allow-Origin", "value": "*" }
        ]
      },
      {
        "source": "**/*.html",
        "headers": [
          { "key": "Cache-Control", "value": "public, max-age=0, must-revalidate" }
        ]
      }
    ]
  }
}
